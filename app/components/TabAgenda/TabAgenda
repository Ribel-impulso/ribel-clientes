'use client'
import { useState } from 'react'

interface Props {
  sesiones: any[]
  clientes: any[]
  servicios: any[]
  mesSeleccionado: string
  setMesSeleccionado: (v: string) => void
  agregarSesion: () => void
  clienteSeleccionado: string
  setClienteSeleccionado: (v: string) => void
  busquedaCliente: string
  setBusquedaCliente: (v: string) => void
  servicioSeleccionado: string
  setServicioSeleccionado: (v: string) => void
  busquedaServicio: string
  setBusquedaServicio: (v: string) => void
  fecha: string
  setFecha: (v: string) => void
  horario: string
  setHorario: (v: string) => void
  monto: string
  setMonto: (v: string) => void
  formaPago: string
  setFormaPago: (v: string) => void
  card: React.CSSProperties
  input: React.CSSProperties
  btnPrimary: React.CSSProperties
  btnSecondary: React.CSSProperties
}

export default function TabAgenda({
  sesiones, clientes, servicios,
  mesSeleccionado, setMesSeleccionado,
  agregarSesion,
  clienteSeleccionado, setClienteSeleccionado,
  busquedaCliente, setBusquedaCliente,
  servicioSeleccionado, setServicioSeleccionado,
  busquedaServicio, setBusquedaServicio,
  fecha, setFecha, horario, setHorario,
  monto, setMonto, formaPago, setFormaPago,
  card, input, btnPrimary, btnSecondary
}: Props) {

  const [diaSeleccionado, setDiaSeleccionado] = useState<string | null>(null)

  const year = parseInt(mesSeleccionado.slice(0, 4))
  const month = parseInt(mesSeleccionado.slice(5, 7)) - 1
  const primerDia = new Date(year, month, 1).getDay()
  const diasEnMes = new Date(year, month + 1, 0).getDate()

  const turnosPorDia: Record<string, any[]> = {}
  sesiones.forEach(s => {
    if (s.fecha?.startsWith(mesSeleccionado)) {
      if (!turnosPorDia[s.fecha]) turnosPorDia[s.fecha] = []
      turnosPorDia[s.fecha].push(s)
    }
  })

  const diasSemana = ['Dom', 'Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb']

  function formatFecha(dia: number) {
    const mm = String(month + 1).padStart(2, '0')
    const dd = String(dia).padStart(2, '0')
    return ${year}-${mm}-${dd}
  }

  const serviciosFiltrados = servicios.filter(s =>
    s.nombre.toLowerCase().includes(busquedaServicio.toLowerCase()) ||
    s.codigo.toLowerCase().includes(busquedaServicio.toLowerCase())
  )

  function handleDia(dia: number) {
    const f = formatFecha(dia)
    setDiaSeleccionado(f)
    setFecha(f)
  }

  return (
    <>
      {/* CALENDARIO */}
      <div style={card}>
        <h2 style={{ color: '#161616', marginTop: 0 }}>Agenda</h2>
        <input type="month" value={mesSeleccionado} onChange={e => setMesSeleccionado(e.target.value)} style={input} />

        {/* GRILLA */}
        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(7, 1fr)', gap: '4px', marginTop: '12px' }}>
          {diasSemana.map(d => (
            <div key={d} style={{ textAlign: 'center', fontWeight: 'bold', fontSize: '12px', color: '#9e9e9e', padding: '4px' }}>{d}</div>
          ))}
          {Array.from({ length: primerDia }).map((_, i) => (
            <div key={empty-${i}} />
          ))}
          {Array.from({ length: diasEnMes }).map((_, i) => {
            const dia = i + 1
            const f = formatFecha(dia)
            const turnos = turnosPorDia[f] || []
            const seleccionado = diaSeleccionado === f
            return (
              <div
                key={dia}
                onClick={() => handleDia(dia)}
                style={{
                  borderRadius: '8px',
                  padding: '6px 4px',
                  textAlign: 'center',
                  cursor: 'pointer',
                  backgroundColor: seleccionado ? '#ba9a7d' : turnos.length > 0 ? '#f0e6d3' : '#f9f7f4',
                  border: seleccionado ? '2px solid #ba9a7d' : '1px solid #e3dfd6',
                  minHeight: '48px'
                }}>
                <div style={{ fontSize: '13px', fontWeight: 'bold', color: seleccionado ? '#fff' : '#161616' }}>{dia}</div>
                {turnos.length > 0 && (
                  <div style={{ fontSize: '10px', color: seleccionado ? '#fff' : '#ba9a7d' }}>
                    {turnos.length} turno{turnos.length > 1 ? 's' : ''}
                  </div>
                )}
              </div>
            )
          })}
        </div>
      </div>

      {/* PANEL DIA SELECCIONADO */}
      {diaSeleccionado && (
        <div style={card}>
          <h3 style={{ color: '#161616', marginTop: 0 }}>
            {new Date(diaSeleccionado + 'T12:00:00').toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long' })}
          </h3>

          {/* TURNOS DEL DIA */}
          {(turnosPorDia[diaSeleccionado] || []).length > 0 && (
            <div style={{ marginBottom: '16px' }}>
              <p style={{ fontWeight: 'bold', color: '#161616', marginBottom: '8px' }}>Turnos del día:</p>
              {(turnosPorDia[diaSeleccionado] || []).map(s => (
                <div key={s.id} style={{ backgroundColor: '#f0e6d3', borderRadius: '8px', padding: '10px 14px', marginBottom: '6px' }}>
                  <p style={{ margin: 0, color: '#161616', fontWeight: 'bold' }}>{s.horario || 'Sin horario'} — {s.clientes?.nombre || 'Sin cliente'}</p>
                  <p style={{ margin: '2px 0 0', color: '#9e9e9e', fontSize: '13px' }}>{s.tipo_masaje || 'Sin servicio'} · ${s.monto}</p>
                </div>
              ))}
            </div>
          )}

          {/* AGREGAR TURNO */}
          <p style={{ fontWeight: 'bold', color: '#161616', marginBottom: '8px' }}>Agendar turno:</p>
          <input
            placeholder="Buscar cliente..."
            value={busquedaCliente}
            onChange={e => { setBusquedaCliente(e.target.value); setClienteSeleccionado('') }}
            style={input}
          />
          {busquedaCliente && !clienteSeleccionado && (
            <ul style={{ border: '1px solid #ccc', borderRadius: '8px', padding: '8px', listStyle: 'none', margin: '0 0 8px' }}>
              {clientes.filter(c => c.nombre.toLowerCase().includes(busquedaCliente.toLowerCase())).map(c => (
                <li key={c.id} onClick={() => { setClienteSeleccionado(c.id); setBusquedaCliente(c.nombre) }}
                  style={{ padding: '8px', cursor: 'pointer', color: '#161616' }}>{c.nombre}</li>
              ))}
            </ul>
          )}
          <input type="time" value={horario} onChange={e => setHorario(e.target.value)} style={input} />
          <input
            placeholder="Buscar servicio..."
            value={busquedaServicio}
            onChange={e => { setBusquedaServicio(e.target.value); setServicioSeleccionado('') }}
            style={input}
          />
          {busquedaServicio && serviciosFiltrados.length > 0 && !servicioSeleccionado && (
            <ul style={{ border: '1px solid #e3dfd6', borderRadius: '8px', padding: '8px', listStyle: 'none', margin: '0 0 8px' }}>
              {serviciosFiltrados.map(s => (
                <li key={s.id} onClick={() => { setServicioSeleccionado(s.nombre); setBusquedaServicio(s.codigo + ' - ' + s.nombre) }}
                  style={{ padding: '6px', cursor: 'pointer', color: '#161616' }}>{s.codigo} - {s.nombre}</li>
              ))}
            </ul>
          )}
          <input placeholder="Monto" type="number" value={monto} onChange={e => setMonto(e.target.value)} style={input} />
          <select value={formaPago} onChange={e => setFormaPago(e.target.value)} style={input}>
            <option value="efectivo">Efectivo</option>
            <option value="transferencia">Transferencia</option>
            <option value="obra_social">Obra Social</option>
            <option value="cuenta_corriente">Cuenta corriente</option>
          </select>
          <br />
          <button onClick={() => { agregarSesion(); setDiaSeleccionado(null) }} style={btnPrimary}>Agendar Turno</button>
        </div>
      )}
    </>
  )
}